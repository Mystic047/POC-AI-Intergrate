# ===========================================
# AI Provider Configuration
# ===========================================
# Choose AI provider: "ollama" or "github"
AI_PROVIDER=github

# ===========================================
# Ollama Configuration (Local Docker)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2

# ===========================================
# GitHub Models Configuration (Cloud)
# ===========================================
# Get your token: https://github.com/settings/tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_MODEL=gpt-4o-mini
# Available models: gpt-4o, gpt-4o-mini, Llama-3.3-70B-Instruct, Mistral-large-2411

# ===========================================
# Data Configuration
# ===========================================
# Optional: Path to CSV file (defaults to ./data/maintenance_costs.csv)
# CSV_FILE_PATH=./data/maintenance_costs.csv
